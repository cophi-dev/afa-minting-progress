# Server-only. Set this in Vercel → Project → Settings → Environment Variables
# for Production and Preview. Do not prefix it with VITE_ or REACT_APP_.
ETHERSCAN_API_KEY=

# Optional. When unset, the mint API tries public Ethereum mainnet RPCs,
# then the Etherscan eth_call proxy.
# ETH_RPC_URL=

# Alchemy mint webhook store. This project uses Vercel Blob (no KV).
# BLOB_READ_WRITE_TOKEN=
# ALCHEMY_WEBHOOK_SIGNING_KEY=
# ALCHEMY_API_KEY=
# MINTS_SYNC_TOKEN=
# CRON_SECRET=
